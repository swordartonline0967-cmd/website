---
/**
 * ハード詳細ページ  /platforms/<機種ID>/
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GameTable from '../../../components/GameTable.astro';
import ListFilter from '../../../components/ListFilter.astro';
import ShopLinks from '../../../components/ShopLinks.astro';
import { getGamesByPlatform, getGenres, getPlatform, getPlatformYears, getPlatforms, getUndatedGames, makerByName } from '../../../lib/data';
import { formatDate, formatNumber, formatPrice, yearOf } from '../../../lib/format';
import { PLATFORM_TYPE_LABEL } from '../../../lib/platform-style';
import { makerUrl, platformYearUrl, url } from '../../../lib/url';

export function getStaticPaths() {
  return getPlatforms().map((p) => ({ params: { platform: p.id } }));
}

const p = getPlatform(Astro.params.platform!)!;
const games = getGamesByPlatform(p.id);
const years = getPlatformYears(p.id);
const maxYearCount = Math.max(1, ...years.map((y) => y.count));
const undated = getUndatedGames(p.id);
const dlCount = games.filter((g) => g.digitalOnly).length;
const FULL_LIST_LIMIT = 1500;
const showFull = games.length <= FULL_LIST_LIMIT;
const today = new Date().toISOString().slice(0, 10);
const recent = games.filter((g) => g.date && g.date.length === 10 && g.date <= today).slice(-30).reverse();

// ジャンル別・発売元別の本数
const genreCounts = getGenres()
  .map((g) => ({ ...g, count: games.filter((x) => x.genres?.includes(g.id)).length }))
  .filter((g) => g.count > 0);
const pubCounts = new Map<string, number>();
for (const g of games) for (const n of g.publishers ?? []) pubCounts.set(n, (pubCounts.get(n) ?? 0) + 1);
const topPublishers = [...pubCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 20);

const firstYear = years[0]?.year;
const lastYear = years.at(-1)?.year;
const title = `${p.name}のソフト一覧（全${formatNumber(games.length)}本）`;
const description = `${p.name}（${p.shortName}）は${formatDate(p.releaseDate)}に${p.maker}から発売された${PLATFORM_TYPE_LABEL[p.type]}ゲーム機。発売されたソフト${formatNumber(games.length)}本を発売年別・ジャンル別・メーカー別に一覧で紹介します。`;
const sourceLinks = (p.sources ?? []).map((s) => ({ name: s, href: `https://ja.wikipedia.org/wiki/${encodeURIComponent(s.replace(/ /g, '_'))}` }));
---
<BaseLayout title={title} description={description} breadcrumbs={[{ name: 'ハード一覧', href: url('/platforms/') }, { name: p.name }]}>
  <div class="page-head">
    <h1>{p.name}</h1>
    <p class="lead">{p.description}</p>
  </div>

  <div class="layout-2col">
    <div>
      <section class="card">
        <table class="info-table">
          <tbody>
            <tr><th scope="row">正式名称</th><td>{p.name}</td></tr>
            <tr><th scope="row">通称・略称</th><td>{p.shortName}（{p.abbr}）</td></tr>
            <tr><th scope="row">発売元</th><td>{p.maker}</td></tr>
            <tr><th scope="row">発売日</th><td>{formatDate(p.releaseDate)}</td></tr>
            <tr><th scope="row">発売時の価格</th><td>{p.price ? formatPrice(p.price) : '—'}{p.priceNote && <span class="muted small">（{p.priceNote}）</span>}</td></tr>
            <tr><th scope="row">種類</th><td>{PLATFORM_TYPE_LABEL[p.type]}・第{p.generation}世代</td></tr>
            {p.media && <tr><th scope="row">ソフトの媒体</th><td>{p.media}</td></tr>}
            <tr><th scope="row">掲載ソフト数</th><td>
              <strong>{formatNumber(games.length)}</strong>本
              {dlCount > 0 && <span class="muted small">（うちダウンロード専用 {formatNumber(dlCount)}本）</span>}
              {firstYear && <span class="muted small"><br />{firstYear}年〜{lastYear}年に発売</span>}
            </td></tr>
          </tbody>
        </table>
      </section>

      <ShopLinks keyword={`${p.name} 本体`} heading={`${p.shortName}の本体を探す`} retro={Number(p.releaseDate.slice(0, 4)) < 2010} />
    </div>
    <aside>
      <section class="card">
        <div class="card-title"><h2>発売年別のソフト数</h2></div>
        <ul class="bar-list" style={`--pc:${p.color}`}>
          {years.map((y) => (
            <li>
              <a href={platformYearUrl(p.id, y.year)}>{y.year}年</a>
              <span class="bar" style={`width:${Math.max(2, Math.round((y.count / maxYearCount) * 100))}%`}></span>
              <span class="num">{formatNumber(y.count)}本</span>
            </li>
          ))}
        </ul>
        {undated.length > 0 && <p class="small muted" style="margin:8px 0 0">ほかに発売日未定のソフトが{undated.length}本あります。</p>}
      </section>
    </aside>
  </div>

  {genreCounts.length > 0 && (
    <section class="card">
      <div class="card-title"><h2>ジャンル別</h2></div>
      <ul class="chip-list">
        {genreCounts.map((g) => <li><a class="chip" href={url(`/genres/${g.id}/${p.id}/`)}>{g.name}<span class="count">{formatNumber(g.count)}</span></a></li>)}
      </ul>
      <p class="small muted" style="margin:10px 0 0">※ジャンルはWikidataに登録されている情報をもとに分類しており、一部のソフトのみ対応しています。</p>
    </section>
  )}

  <section class="card">
    <div class="card-title"><h2>ソフトが多い発売元</h2></div>
    <ul class="chip-list">
      {topPublishers.map(([name, n]) => {
        const m = makerByName(name);
        return <li>{m ? <a class="chip" href={makerUrl(m.id)}>{name}<span class="count">{n}</span></a> : <span class="chip">{name}<span class="count">{n}</span></span>}</li>;
      })}
    </ul>
  </section>

  {showFull ? (
    <section id="all-games">
      <h2 class="section-title">{p.shortName}のソフト一覧（発売日順）</h2>
      <ListFilter target="#all-games" showPackageToggle={dlCount > 0} />
      {years.map((y) => (
        <div data-filter-section>
          <h3 class="month-heading" id={`y${y.year}`}><a href={platformYearUrl(p.id, y.year)}>{y.year}年</a>（{y.count}本）</h3>
          <GameTable games={games.filter((g) => yearOf(g.date) === y.year)} />
        </div>
      ))}
      {undated.length > 0 && (
        <div data-filter-section>
          <h3 class="month-heading">発売日未定</h3>
          <GameTable games={undated} />
        </div>
      )}
    </section>
  ) : (
    <section>
      <h2 class="section-title">最近発売された{p.shortName}ソフト</h2>
      <p class="muted small">ソフトの数が多いため、すべてのソフトは発売年ごとのページでご覧ください：
        {years.map((y, i) => <>{i > 0 && ' ／ '}<a href={platformYearUrl(p.id, y.year)}>{y.year}年</a></>)}
      </p>
      <GameTable games={recent} />
      {undated.length > 0 && (
        <>
          <h3 class="month-heading">発売日未定</h3>
          <GameTable games={undated} />
        </>
      )}
    </section>
  )}

  <p class="muted small" style="margin-top:24px">
    ソフト一覧の出典: {sourceLinks.map((s, i) => <>{i > 0 && '、'}<a href={s.href} target="_blank" rel="noopener">Wikipedia「{s.name}」</a></>)}（CC BY-SA 4.0）
  </p>
</BaseLayout>
